// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Your profile table (now includes auth user id as UUID primary key)
model Profile {
  id               String    @id @default(uuid()) @db.Uuid
  role             String?   @default("student")  // 'student', 'school_admin', 'company', 'recruiter', 'event_organizer', 'admin', 'super_admin'
  nin              String?   @unique
  fullName         String?
  dateOfBirth      DateTime?
  gender           String?
  stateOfOrigin    String?
  phoneNumber      String?
  email            String?   @unique
  password         String?   // Hashed password
  avatar           String?   // URL to profile picture
  isVerified       Boolean   @default(false)
  isOpenToRecruiters Boolean @default(false) // Global consent flag
  institutionId    String?
  institution      Institution? @relation(fields: [institutionId], references: [id])
  
  // Admin-specific fields
  permissions      Json?         // Array of permission strings for admin roles
  createdBy        String?       // ID of super admin who created this admin

  // Relations
  academicRecords  AcademicRecord[]
  extracurriculars ExtracurricularActivity[]
  eventParticipations EventParticipation[]
  
  // Access Control
  sentRequests     AccessRequest[] @relation("SentRequests")
  receivedRequests AccessRequest[] @relation("ReceivedRequests")
  
  // Recruitment
  company          Company?
  shortlistedBy    Shortlist[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ninRef           Nin?      @relation(fields: [nin], references: [nin], onDelete: SetNull)

  @@map("profiles")
}

model AccessRequest {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @db.Uuid
  studentId   String   @db.Uuid
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  requester   Profile  @relation("SentRequests", fields: [requesterId], references: [id])
  student     Profile  @relation("ReceivedRequests", fields: [studentId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, studentId]) // One request per pair
  @@map("access_requests")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otps")
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_tokens")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  type        String   // e.g., 'Primary', 'Secondary', 'University', 'Waec', 'Jamb'
  address     String?
  state       String?
  cgpaScale   Float?   @default(5.0) // Max CGPA scale for tertiary institutions
  
  academicRecords AcademicRecord[]
  members         Profile[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("institutions")
}

model AcademicRecord {
  id            String      @id @default(uuid())
  profileId     String      @db.Uuid
  institutionId String
  
  session       String      // e.g., "2023/2024"
  term          String?     // e.g., "First Term", "Semester 1"
  level         String?     // e.g., "JSS1", "100L"
  subject       String      // or Course Title
  code          String?     // e.g., "MTH101"
  grade         String?     // e.g., "A", "B"
  score         Float?      // e.g., 75.5
  classRank     Int?        // Student's rank in class (1 = top)
  classSize     Int?        // Total students in class
  isVerified    Boolean     @default(false)
  verifiedBy    String?     // e.g. Admin or Teacher ID
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@map("academic_records")
}

model ExtracurricularActivity {
  id          String   @id @default(uuid())
  profileId   String   @db.Uuid
  
  title       String
  description String?
  date        DateTime?
  role        String?  // e.g., "Team Lead", "Member"
  category    String?  // e.g., "Sports", "Volunteering"
  proofUrl    String?  // URL to certificate or image
  isVerified  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("extracurricular_activities")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  events      Event[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("organizations")
}

model Event {
  id             String   @id @default(uuid())
  organizationId String
  
  name           String
  description    String?
  date           DateTime?
  type           String   // 'hackathon', 'competition', 'workshop', etc.
  isRecognized   Boolean  @default(false)
  
  participations EventParticipation[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("events")
}

model EventParticipation {
  id            String   @id @default(uuid())
  eventId       String
  profileId     String   @db.Uuid
  
  position      String?  // e.g., "1st", "Finalist"
  score         Float?
  award         String?  // e.g., "Gold Medal"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event         Event    @relation(fields: [eventId], references: [id])
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("event_participations")
}

// Your Nin table (unchanged, in public)
model Nin {
  nin              String    @id @unique
  fullName         String
  dateOfBirth      DateTime
  gender           String
  stateOfOrigin    String?
  phoneNumber      String?
  email            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile          Profile?

  @@index([nin])
}

model Company {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  website     String?
  description String?
  
  profileId   String   @unique @db.Uuid  // Links to recruiter's profile
  profile     Profile  @relation(fields: [profileId], references: [id])
  
  shortlists  Shortlist[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("companies")
}

model Shortlist {
  id          String   @id @default(uuid())
  companyId   String
  studentId   String   @db.Uuid
  notes       String?
  status      String   @default("shortlisted") // shortlisted, interviewed, offered, rejected
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student     Profile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([companyId, studentId])
  @@map("shortlists")
}
